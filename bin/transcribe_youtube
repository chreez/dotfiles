#!/bin/bash

# YouTube Transcription Script
# Usage: ./transcribe_youtube.sh <youtube_url> [output_filename]
# REQUIRES: yt-dlp, mkdir, rm, ls, head, awk, sed, tr, cut, brew (for auto-install)

if [ $# -eq 0 ]; then
    echo "Usage: $0 <youtube_url> [output_filename]"
    echo "Example: $0 'https://www.youtube.com/watch?v=dQw4w9WgXcQ' my_transcript.txt"
    exit 1
fi

URL="$1"

# Extract YouTube video ID from URL
VIDEO_ID=$(echo "$URL" | sed -n 's/.*[?&]v=\([^&]*\).*/\1/p' | head -c 11)

# Get video title and create filename if not provided
if [ -z "$2" ]; then
    # Get video title using yt-dlp
    VIDEO_TITLE=$(yt-dlp --get-title "$URL" 2>/dev/null | head -1)
    
    if [ -n "$VIDEO_TITLE" ]; then
        # Clean title: lowercase, replace spaces/special chars with dots, limit length
        CLEAN_TITLE=$(echo "$VIDEO_TITLE" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/ /g' | tr -s ' ' | sed 's/^ *//;s/ *$//' | tr ' ' '.' | cut -c1-40)
        OUTPUT="${CLEAN_TITLE}.${VIDEO_ID}.txt"
    else
        OUTPUT="transcript.${VIDEO_ID}.txt"
    fi
else
    OUTPUT="$2"
fi

# Use working directory for temporary files to avoid permission issues
TMP_DIR="./tmp_transcribe_$$"
mkdir -p "$TMP_DIR"
trap "rm -rf $TMP_DIR" EXIT

# Check if yt-dlp is installed
if ! command -v yt-dlp &> /dev/null; then
    echo "yt-dlp not found. Installing via Homebrew..."
    brew install yt-dlp
fi

# Extract subtitles to temporary directory
echo "Extracting subtitles from: $URL"
yt-dlp --write-subs --write-auto-subs --sub-langs en --skip-download -o "$TMP_DIR/%(title)s.%(ext)s" "$URL"

# Find the VTT file (handles special characters in filenames)
VTT_FILE=$(ls "$TMP_DIR"/*.en.vtt 2>/dev/null | head -1)

if [ -z "$VTT_FILE" ]; then
    echo "No subtitle file found. Video may not have subtitles available."
    exit 1
fi

# Clean up the VTT file to plain text
echo "Cleaning transcript..."
awk '/^WEBVTT/{next} /^$/{next} /^[0-9][0-9]:/{next} /Kind:/{next} /Language:/{next} {gsub(/<[^>]*>/,""); if(length && !seen[$0]++) print}' "$VTT_FILE" > "$OUTPUT"

echo "Transcript saved to: $OUTPUT"