#!/bin/bash

# YouTube Transcription Script
# Usage: ./transcribe_youtube <youtube_url> [output_filename]

if [ $# -eq 0 ]; then
    echo "Usage: $0 <youtube_url> [output_filename]"
    echo "Example: $0 'https://www.youtube.com/watch?v=dQw4w9WgXcQ'"
    echo "Auto-generates intuitive filename from video title if not specified"
    exit 1
fi

URL="$1"
OUTPUT="$2"

# Generate filename from video title if not provided
generate_filename() {
    local url="$1"
    
    # Extract video title
    local title=$(yt-dlp --print title --no-warnings "$url" 2>/dev/null)
    if [ $? -ne 0 ] || [ -z "$title" ]; then
        echo "transcript.txt"
        return
    fi
    
    # Extract video ID from URL
    local video_id=$(echo "$url" | grep -oE '([0-9A-Za-z_-]{11})')
    if [ -z "$video_id" ]; then
        video_id="unknown"
    fi
    
    # Clean title: remove special chars, convert to lowercase
    local cleaned=$(echo "$title" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9 ]//g' | sed 's/  */ /g' | sed 's/^ *//;s/ *$//')
    
    # Take first 6 words
    local short_title=$(echo "$cleaned" | cut -d' ' -f1-6 | tr ' ' '.')
    
    # Truncate if too long
    if [ ${#short_title} -gt 50 ]; then
        short_title="${short_title:0:47}..."
    fi
    
    echo "${short_title}.${video_id}.txt"
}

# Use provided filename or generate one
if [ -z "$OUTPUT" ]; then
    OUTPUT=$(generate_filename "$URL")
fi

# Create temporary directory and clean up on exit
TMP_DIR=$(mktemp -d)
trap "rm -rf $TMP_DIR" EXIT

# Check if yt-dlp is installed
if ! command -v yt-dlp &> /dev/null; then
    echo "yt-dlp not found. Installing via Homebrew..."
    brew install yt-dlp
fi

# Extract subtitles to temporary directory
echo "Extracting subtitles from: $URL"
cd "$TMP_DIR"
yt-dlp --write-subs --write-auto-subs --sub-langs en --skip-download "$URL"

# Find the VTT file (handles special characters in filenames)
VTT_FILE=$(find . -name "*.en.vtt" -type f | head -1)

if [ -z "$VTT_FILE" ]; then
    echo "No subtitle file found. Video may not have subtitles available."
    exit 1
fi

# Clean up the VTT file to plain text and save to specified output location
echo "Cleaning transcript..."
grep -v "^WEBVTT" "$VTT_FILE" | \
grep -v "^$" | \
grep -v "^[0-9][0-9]:" | \
grep -v "Kind:" | \
grep -v "Language:" | \
sed 's/<[^>]*>//g' | \
sort -n | \
uniq | \
grep -v "^$" | \
sed 's/^[[:space:]]*//' > "$OLDPWD/$OUTPUT"

echo "Transcript saved to: $OUTPUT"