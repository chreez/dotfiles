#!/usr/bin/env bash

set -euo pipefail

# spec_validator - Wrapper for techman spec-validator tool
# REQUIRES: git, which, curl, jq (for JSON parsing)

# Find techman directory by looking for it in common workspace locations
TECHMAN_DIR=""
SEARCH_PATHS=(
    "$HOME/workspace/techman"
    "$HOME/projects/techman"
    "$HOME/dev/techman"
)

for path in "${SEARCH_PATHS[@]}"; do
    if [[ -d "$path" && -x "$path/bin/spec-validator" ]]; then
        TECHMAN_DIR="$path"
        break
    fi
done

if [[ -z "$TECHMAN_DIR" ]]; then
    echo "Error: techman directory not found. Please ensure techman is installed in one of:" >&2
    printf "  %s\n" "${SEARCH_PATHS[@]}" >&2
    exit 1
fi

# Check for required API keys
if [[ -z "${ANTHROPIC_API_KEY:-}" && -z "${OPENAI_API_KEY:-}" ]]; then
    echo "Error: Either ANTHROPIC_API_KEY or OPENAI_API_KEY environment variable must be set" >&2
    exit 1
fi

# Convert relative paths to absolute paths if needed
args=()
for arg in "$@"; do
    # Skip flags and special arguments
    if [[ "$arg" == -* ]] || [[ "$arg" == "--diff" ]] || [[ "$arg" == "-" ]]; then
        args+=("$arg")
    else
        # Convert relative paths to absolute paths
        if [[ -f "$arg" ]]; then
            args+=("$(realpath "$arg")")
        elif [[ -f "$PWD/$arg" ]]; then
            args+=("$(realpath "$PWD/$arg")")
        else
            # Keep the original argument (might be a valid path from techman's perspective)
            args+=("$arg")
        fi
    fi
done

# Execute the actual spec-validator with converted paths
cd "$TECHMAN_DIR" || exit 1
exec ./bin/spec-validator "${args[@]}"