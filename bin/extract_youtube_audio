#!/bin/bash

# extract_youtube_audio - Extract audio from YouTube videos in MP3 format
# Usage: ./extract_youtube_audio <youtube_url> [output_filename]
# REQUIRES: yt-dlp, mkdir, rm, ls, head, awk, sed, tr, cut, brew (for auto-install)

if [ $# -eq 0 ]; then
    echo "Usage: $0 <youtube_url> [output_filename]"
    echo "Example: $0 'https://www.youtube.com/watch?v=dQw4w9WgXcQ' my_audio.mp3"
    exit 1
fi

# Quote the URL to handle special characters like ? and &
# This prevents shell glob expansion errors
URL="$1"

# Extract YouTube video ID from URL
VIDEO_ID=$(echo "$URL" | sed -n 's/.*[?&]v=\([^&]*\).*/\1/p' | head -c 11)

# Get video title and create filename if not provided
if [ -z "$2" ]; then
    # Get video title using yt-dlp
    VIDEO_TITLE=$(yt-dlp --get-title "$URL" 2>/dev/null | head -1)
    
    if [ -n "$VIDEO_TITLE" ]; then
        # Clean title: lowercase, replace spaces/special chars with dots, limit length
        CLEAN_TITLE=$(echo "$VIDEO_TITLE" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/ /g' | tr -s ' ' | sed 's/^ *//;s/ *$//' | tr ' ' '.' | cut -c1-40)
        OUTPUT="${CLEAN_TITLE}.${VIDEO_ID}.mp3"
    else
        OUTPUT="audio.${VIDEO_ID}.mp3"
    fi
else
    OUTPUT="$2"
fi

# Use working directory for temporary files to avoid permission issues
TMP_DIR="./tmp_extract_youtube_audio_$$"
mkdir -p "$TMP_DIR"
trap "rm -rf $TMP_DIR" EXIT

# Check if yt-dlp is installed
if ! command -v yt-dlp &> /dev/null; then
    echo "yt-dlp not found. Installing via Homebrew..."
    brew install yt-dlp
fi

# Extract audio from YouTube video
echo "Extracting audio from: $URL"
yt-dlp --extract-audio --audio-format mp3 --audio-quality 0 -o "$TMP_DIR/%(title)s.%(ext)s" "$URL"

# Find the MP3 file (handles special characters in filenames)
MP3_FILE=$(ls "$TMP_DIR"/*.mp3 2>/dev/null | head -1)

if [ -z "$MP3_FILE" ]; then
    echo "No audio file found. Video may not have audio available."
    exit 1
fi

# Move the file to the desired output name
mv "$MP3_FILE" "$OUTPUT"

echo "Audio saved to: $OUTPUT"